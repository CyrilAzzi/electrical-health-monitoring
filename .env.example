# PostgreSQL
POSTGRES_USER=ehm_user
POSTGRES_PASSWORD=ehm_password
POSTGRES_DB=ehm_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ehm_user:ehm_password@postgres:5432/ehm_db

# MQTT
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=sensors/+/measurements

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
